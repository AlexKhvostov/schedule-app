{
  "openapi": "3.1.0",
  "info": {
    "title": "RedParty External API",
    "version": "1.1.0",
    "description": "Local implementation, not deployed. Individual integration keys. Immutable 15-minute exports, 1000 marks per page."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:54321/functions/v1/external-api",
      "description": "Local Supabase"
    }
  ],
  "security": [
    {
      "IntegrationKey": []
    }
  ],
  "paths": {
    "/v1/schedule": {
      "get": {
        "operationId": "getSchedule",
        "summary": "Read occupied schedule half-hours",
        "parameters": [
          {
            "name": "date",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date"
            },
            "description": "First calendar date in Europe/Madrid; explicit YYYY-MM-DD, not today. Required on the first request; forbidden with cursor."
          },
          {
            "name": "days",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 31
            },
            "description": "Includes date: 3 means this date and the next two. Required on the first request; forbidden with cursor."
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "^\\d{1,4}(\\.\\d{1,2})?$"
            },
            "description": "Exact buy-in catalog ID, e.g. 50 or 0.50. Omitted = all. Not a row limit."
          },
          {
            "name": "variant",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "nitro",
                "regular"
              ]
            },
            "description": "Omitted = both types."
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Opaque current/next page cursor. When present, it must be the only query parameter."
          }
        ],
        "responses": {
          "200": {
            "description": "One immutable page of at most 1000 marks; all requested dates appear, empty arrays are page-local. Follow pagination.next_cursor until has_more=false. All pages retain the same metadata, names and marks.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Schedule"
                }
              }
            }
          },
          "400": {
            "description": "Invalid, duplicate or unknown parameter",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid, revoked or expired integration key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Key lacks schedule:read",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Unknown route",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "405": {
            "description": "Only GET is supported",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Safety limit: one raw page exceeds 4 MiB, final JSON 5 MiB, or export exceeds 250000 marks / 128 MiB. No partial snapshot is created; narrow the request.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Request quota or active-export quota exceeded. Retry-After gives seconds to wait.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "headers": {
              "Retry-After": {
                "schema": {
                  "type": "integer",
                  "minimum": 1
                },
                "description": "Seconds until the next request window"
              }
            }
          },
          "503": {
            "description": "Database or service unavailable; never interpreted as an empty schedule",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "410": {
            "description": "Snapshot expired, removed, unknown or unavailable to this integration. Discard partial data and restart the original date/days request.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "description": "First request: date and days are required, filters optional. Continuation/replay: cursor alone, no date/days/filters. Each request needs the same active integration key. Discard all partial data and restart on 410. Merge pages by date, line.id and slot.id; empty arrays are page-local."
      }
    }
  },
  "components": {
    "securitySchemes": {
      "IntegrationKey": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key",
        "description": "Individual rp_ key with schedule:read; never a Supabase project secret."
      }
    },
    "schemas": {
      "Owner": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "member_id",
          "display_name",
          "profile_name",
          "discord_id",
          "discord_username",
          "discord_global_name",
          "discord_guild_nick",
          "game_nick"
        ],
        "properties": {
          "member_id": {
            "type": "string"
          },
          "display_name": {
            "type": "string"
          },
          "profile_name": {
            "type": [
              "string",
              "null"
            ]
          },
          "discord_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "discord_username": {
            "type": [
              "string",
              "null"
            ]
          },
          "discord_global_name": {
            "type": [
              "string",
              "null"
            ]
          },
          "discord_guild_nick": {
            "type": [
              "string",
              "null"
            ]
          },
          "game_nick": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "Mark": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "text",
          "background",
          "foreground"
        ],
        "properties": {
          "text": {
            "type": [
              "string",
              "null"
            ]
          },
          "background": {
            "type": [
              "string",
              "null"
            ]
          },
          "foreground": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "Slot": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "half",
          "start_local",
          "end_local",
          "start_at",
          "end_at",
          "time_resolution",
          "mark",
          "tables",
          "owner"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "half": {
            "type": "integer",
            "minimum": 0,
            "maximum": 47
          },
          "start_local": {
            "type": "string"
          },
          "end_local": {
            "type": "string"
          },
          "start_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "end_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "time_resolution": {
            "type": "string",
            "enum": [
              "exact",
              "ambiguous",
              "nonexistent",
              "transition"
            ]
          },
          "mark": {
            "$ref": "#/components/schemas/Mark"
          },
          "tables": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1,
            "maximum": 30
          },
          "owner": {
            "$ref": "#/components/schemas/Owner"
          }
        }
      },
      "Line": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "number",
          "room",
          "variant",
          "limit",
          "currency",
          "slots"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "number": {
            "type": "integer",
            "minimum": 1,
            "maximum": 6
          },
          "room": {
            "const": "winamax"
          },
          "variant": {
            "enum": [
              "nitro",
              "regular"
            ]
          },
          "limit": {
            "type": "string"
          },
          "currency": {
            "const": "EUR"
          },
          "slots": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Slot"
            }
          }
        }
      },
      "Day": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "date",
          "lines"
        ],
        "properties": {
          "date": {
            "type": "string",
            "format": "date"
          },
          "lines": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Line"
            }
          }
        }
      },
      "Schedule": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "api_version",
          "timezone",
          "date_from",
          "date_to",
          "days_count",
          "slot_minutes",
          "filters",
          "generated_at",
          "slots_count",
          "days",
          "pagination"
        ],
        "properties": {
          "api_version": {
            "const": "1"
          },
          "timezone": {
            "const": "Europe/Madrid"
          },
          "date_from": {
            "type": "string",
            "format": "date"
          },
          "date_to": {
            "type": "string",
            "format": "date"
          },
          "days_count": {
            "type": "integer",
            "minimum": 1,
            "maximum": 31
          },
          "slot_minutes": {
            "const": 30
          },
          "filters": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "limit",
              "variant"
            ],
            "properties": {
              "limit": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "variant": {
                "enum": [
                  "nitro",
                  "regular",
                  null
                ]
              }
            }
          },
          "generated_at": {
            "type": "string",
            "format": "date-time"
          },
          "slots_count": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000
          },
          "days": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Day"
            }
          },
          "pagination": {
            "$ref": "#/components/schemas/Pagination"
          }
        }
      },
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "error",
          "request_id"
        ],
        "properties": {
          "error": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "code"
            ],
            "properties": {
              "code": {
                "enum": [
                  "validation_error",
                  "invalid_api_key",
                  "insufficient_scope",
                  "not_found",
                  "method_not_allowed",
                  "rate_limited",
                  "response_too_large",
                  "schedule_unavailable",
                  "snapshot_unavailable",
                  "snapshot_limit"
                ]
              },
              "field": {
                "type": "string"
              }
            }
          },
          "request_id": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "Pagination": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "snapshot_id",
          "expires_at",
          "page_size",
          "page_number",
          "total_pages",
          "total_slots",
          "cursor",
          "has_more",
          "next_cursor"
        ],
        "properties": {
          "snapshot_id": {
            "type": "string",
            "format": "uuid"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          },
          "page_size": {
            "const": 1000
          },
          "page_number": {
            "type": "integer",
            "minimum": 1
          },
          "total_pages": {
            "type": "integer",
            "minimum": 1
          },
          "total_slots": {
            "type": "integer",
            "minimum": 0,
            "maximum": 250000
          },
          "cursor": {
            "type": "string",
            "format": "uuid"
          },
          "has_more": {
            "type": "boolean"
          },
          "next_cursor": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          }
        }
      }
    }
  }
}
